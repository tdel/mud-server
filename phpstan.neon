includes:
	- vendor/phpstan/phpstan-doctrine/extension.neon
	- vendor/phpstan/phpstan-doctrine/rules.neon
	- vendor/phpstan/phpstan-symfony/extension.neon
	- vendor/phpstan/phpstan-symfony/rules.neon
	- phpstan-baseline.neon

parameters:
	level: 5
	paths:
		- src
		- tests
	excludePaths:
		- tests/bootstrap.php
	# swoole/ide-helper ships no phpstan-extension-installer integration —
	# without this, Co\run() (declared here) is invisible to PHPStan even
	# though it's a real function at runtime (swoole.use_shortname=On).
	scanFiles:
		- vendor/swoole/ide-helper/src/swoole_library/src/alias_ns.php
